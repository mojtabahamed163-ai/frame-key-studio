# Optional local server settings
NODE_ENV=development
PORT=3000

# Optional buyer-owned database for the inherited public inquiry form
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Optional buyer-owned Manus/Forge integrations for inherited platform features
MANUS_PROJECT_ID=your-project-id
MANUS_JWT_SECRET=replace-with-a-random-buyer-owned-secret
MANUS_OAUTH_API_URL=https://your-oauth-service.example
MANUS_OAUTH_PORTAL_URL=https://your-login-portal.example
MANUS_API_URL=https://your-platform-api.example
MANUS_API_KEY=replace-with-a-buyer-owned-server-key
MANUS_API_BROWSER_KEY=replace-with-a-public-browser-key-if-needed
OWNER_OPEN_ID=your-owner-id

# Optional development-only diagnostic collector; disabled unless explicitly true
MANUS_DEBUG_COLLECTOR=false
